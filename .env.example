# Adresse du backend, SANS barre oblique finale.
VITE_API_BASE_URL=http://localhost:8080

# Optionnel : cle Google Maps Embed API (https://console.cloud.google.com/google/maps-apis),
# pour le bouton "Google Maps" de la carte GPS. Sans billing active sur le projet GCP, la
# cle ne fonctionne pas, mais l'Embed API elle-meme n'est jamais facturee a l'usage.
# Vue statique uniquement (pas de marqueurs de camions en direct) : le bouton "OpenStreetMap"
# reste le mode par defaut et le seul avec positions en temps reel.
VITE_GOOGLE_MAPS_EMBED_KEY=